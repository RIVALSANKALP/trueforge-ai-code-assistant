+def test_config(app):
+    app.config["PASSWORD"] = "secret"
+    runner = CliRunner()
+    flask_cli = FlaskGroup(create_app=lambda: app)
+    result = runner.invoke(flask_cli, ["config"])
+    assert result.exit_code == 0
+    data = json.loads(result.output)
+    assert data["SECRET_KEY"] == "***"
+    assert data["PASSWORD"] == "***"
+    assert data["TESTING"] is True
+
+
+def test_config_help(app):
+    runner = CliRunner()
+    flask_cli = FlaskGroup(create_app=lambda: app)
+    result = runner.invoke(flask_cli, ["--help"])
+    assert result.exit_code == 0
+    assert "config" in result.output
+    assert "Show configuration variables." in result.output
+
+
+def test_config_nested_masking(app):
+    app.config["my_secret_token"] = "lowercase_sensitive"
+    app.config["NESTED_DICT"] = {
+        "user_password": "nested_password",
+        "visible_info": "public_nested",
+    }
+    app.config["LIST_OF_DICTS"] = [
+        {"service_key": "list_key", "visible_item": "public_list"},
+        "plain_list_string",
+    ]
+    app.config["TUPLE_OF_DICTS"] = (
+        {"api_token": "tuple_token", "visible_tuple": "public_tuple"},
+    )
+    app.config["VISIBLE_SETTING"] = "visible_top_level"
+
+    runner = CliRunner()
+    flask_cli = FlaskGroup(create_app=lambda: app)
+    result = runner.invoke(flask_cli, ["config"])
+    assert result.exit_code == 0
+    data = json.loads(result.output)
+
+    # A lowercase sensitive key
+    assert data["my_secret_token"] == "***"
+
+    # A sensitive key inside a nested dictionary
+    assert data["NESTED_DICT"]["user_password"] == "***"
+    assert data["NESTED_DICT"]["visible_info"] == "public_nested"
+
+    # A sensitive key inside a dictionary contained in a list
+    assert data["LIST_OF_DICTS"][0]["service_key"] == "***"
+    assert data["LIST_OF_DICTS"][0]["visible_item"] == "public_list"
+    assert data["LIST_OF_DICTS"][1] == "plain_list_string"
+
+    # Tuple structure preserved in JSON with masked dict inside
+    assert data["TUPLE_OF_DICTS"][0]["api_token"] == "***"
+    assert data["TUPLE_OF_DICTS"][0]["visible_tuple"] == "public_tuple"
+
+    # A non-sensitive value that remains visible
+    assert data["VISIBLE_SETTING"] == "visible_top_level"
