+@click.command("config", short_help="Show configuration variables.")
+@with_appcontext
+def config_command() -> None:
+    """Show all configuration variables for the application."""
+    import json
+    import re
+# MANUAL CONFLICT TEST - preserve this change
+    sensitive_pattern = re.compile(r"(SECRET|PASSWORD|TOKEN|KEY)", re.IGNORECASE)
+# PHASE 3 CONFLICT VERIFICATION
+    def mask_val(key: str, val: object) -> object:
+        if sensitive_pattern.search(key):
+            return "***"
+        if isinstance(val, dict):
+            return {k: mask_val(str(k), v) for k, v in val.items()}
+        if isinstance(val, list):
+            return [mask_val("", item) for item in val]
+        if isinstance(val, tuple):
+            return tuple(mask_val("", item) for item in val)
+        return val
+
+    def default_serializer(o: object) -> str:
+        return str(o)
+
+    masked_config = {
+        k: mask_val(k, v) for k, v in current_app.config.items()
+    }
+    click.echo(json.dumps(masked_config, indent=2, default=default_serializer))
